<?xml version="1.0" encoding="UTF-8"?>
<!--
  SignatureForge - Outlook Signature Add-In Manifest

  IMPORTANT: Before deploying, replace ALL occurrences of Ampel-Technologies
  with your actual GitHub username (the one hosting the GitHub Pages site).

  The expected hosting URL is:
    https://dchamorroarias2lsg.github.io/signatureforge/

  The Id below MUST be a unique GUID per deployment.
  Generate a new one if you fork this for another tenant:
    PowerShell: [guid]::NewGuid()
    macOS/Linux: uuidgen
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>70c28186-a242-420b-82c9-599855e65371</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>SignatureForge</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="SignatureForge" />
  <Description DefaultValue="Set Outlook signatures automatically using mailbox identity plus two user-editable fields." />
  <IconUrl DefaultValue="https://dchamorroarias2lsg.github.io/signatureforge/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://dchamorroarias2lsg.github.io/signatureforge/icon-128.png" />
  <SupportUrl DefaultValue="https://dchamorroarias2lsg.github.io/signatureforge/" />

  <AppDomains>
    <AppDomain>https://dchamorroarias2lsg.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://dchamorroarias2lsg.github.io/signatureforge/index.html" />
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
    xsi:type="VersionOverridesV1_0">

    <VersionOverrides
      xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1"
      xsi:type="VersionOverridesV1_1">

      <Requirements>
        <bt:Sets DefaultMinVersion="1.10">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <Runtime resid="WebViewRuntime.Url">
              <Override type="javascript" resid="JSRuntime.Url" />
            </Runtime>
          </Runtimes>

          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url" />
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent
                  Type="OnNewMessageCompose"
                  FunctionName="onNewMessageComposeHandler" />
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url" />
            </ExtensionPoint>

            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="SignatureForge.ComposeGroup">
                  <Label resid="GroupLabel" />
                  <Control xsi:type="Button" id="SignatureForge.SettingsButton">
                    <Label resid="SettingsButton.Label" />
                    <Supertip>
                      <Title resid="SettingsButton.Label" />
                      <Description resid="SettingsButton.Description" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16" />
                      <bt:Image size="32" resid="Icon.32x32" />
                      <bt:Image size="80" resid="Icon.80x80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Settings.Url" />
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>

          <MobileFormFactor>
            <FunctionFile resid="Commands.Url" />

            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent
                  Type="OnNewMessageCompose"
                  FunctionName="onNewMessageComposeHandler" />
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url" />
            </ExtensionPoint>
          </MobileFormFactor>

        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16"
            DefaultValue="https://dchamorroarias2lsg.github.io/signatureforge/icon-16.png" />
          <bt:Image id="Icon.32x32"
            DefaultValue="https://dchamorroarias2lsg.github.io/signatureforge/icon-32.png" />
          <bt:Image id="Icon.80x80"
            DefaultValue="https://dchamorroarias2lsg.github.io/signatureforge/icon-80.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url"
            DefaultValue="https://dchamorroarias2lsg.github.io/signatureforge/commands.html" />
          <bt:Url id="WebViewRuntime.Url"
            DefaultValue="https://dchamorroarias2lsg.github.io/signatureforge/commands.html" />
          <bt:Url id="JSRuntime.Url"
            DefaultValue="https://dchamorroarias2lsg.github.io/signatureforge/launchevent.js" />
          <bt:Url id="Settings.Url"
            DefaultValue="https://dchamorroarias2lsg.github.io/signatureforge/index.html" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="SignatureForge" />
          <bt:String id="SettingsButton.Label" DefaultValue="Signature settings" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Tooltip" DefaultValue="Apply your organization signature automatically." />
          <bt:String id="SettingsButton.Description" DefaultValue="Set the title and phone number used in your signature." />
        </bt:LongStrings>
      </Resources>

    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
